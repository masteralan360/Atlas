{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atlas",
  "version": "0.9.5",
  "identifier": "com.atlas.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Atlas",
        "label": "main",
        "width": 1700,
        "height": 990,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#000000",
        "devtools": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' 'unsafe-inline' https: asset: blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: asset://* http://asset.localhost https://asset.localhost https: data: blob:; media-src 'self' asset: asset://* http://asset.localhost https://asset.localhost; frame-src 'self' blob: data: asset: asset://* http://asset.localhost https://asset.localhost https:; object-src 'self' blob: data: asset: asset://* http://asset.localhost https://asset.localhost https:; connect-src 'self' https: ws: blob: data: asset: asset://* http://asset.localhost https://asset.localhost; font-src 'self' https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://asaas-r2-proxy.alanepic360.workers.dev/atlas-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwOTQ3MENENDBDQTNBRjIKUldUeU9zcEF6WENVNEkzd3FGOFlKckMzMmN6YWNEQjU4ZDFKYXl5dTRnZWsxMzJYZ1ZxenBKdDcK"
    }
  }
}